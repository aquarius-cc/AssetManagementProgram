# =============================================================================
# .gitignore - 根仓库忽略规则
# =============================================================================
# 治理目标：nul 重定向残留、运行时产物、生成报告、会话审计报告、
#           graphify 产物、定时任务运行时锁一律不入库。
# =============================================================================

# Windows 重定向残留（`> nul` 在 PowerShell 下会生成名为 nul 的文件）
nul

# 运行时/日志产物
*.log
.coverage
django.log

# 生成的审计报告产物（停止跟踪，本地保留）
project-audit-report/
project-audit-v3/
document-review-report/
.trae-html-share-packages/

# 过程性文件（审查中间产物，不入库）
audit_report.md

# 会话审计报告
docs/compose/reports/

# 过程性审查文件（不入库）
docs/*对抗核验*.md
docs/*修复完成*.md

# graphify 生成产物
docs/knowledge-graph.html

# 定时任务运行时锁
.mimocode/.cron-lock

# 环境变量文件（含数据库密码、密钥等敏感信息）
.env
.env.local
.env.*.local
node_modules/

# 会话截图/临时产物
snippicture/

# Python 运行时缓存
__pycache__/
*.pyc

# impeccable 运行时数据（critique/audit 快照，不入库）
.impeccable/

# CodeGraph 索引与本机 MCP 配置（67MB 可再生索引；mcp 配置含机器绝对路径，2026-10-16 拍板不入库）
.codegraph/
.mcp.json
mcp.json

# ripgrep 二进制发行包（13 文件，批次 D untrack，本地工具保留不删）
ripgrep/
